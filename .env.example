# Server-only Vercel AI Gateway credential. Never expose this in client code.
VERCEL_AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4o-mini
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1/chat/completions

# Google Maps browser key. Restrict this key by HTTP referrer in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
